# CodeSight AI Backend — Environment Variables
# Copy this file to .env and fill in your values

# Database (PostgreSQL 16 via Docker Compose)
DATABASE_URL=postgresql://admin:password@localhost:5432/codesight

# JWT Authentication
SECRET_KEY=change-me-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services (per ANTIGRAVITY_MEMORY.md: Gemini primary)
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# CORS
CORS_ORIGINS=http://localhost:3000

# Environment
ENV=development
